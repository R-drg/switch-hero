+    void WiiController::MapGuitarExtension(const u8 ext[]) {
+        const auto guitar = fret::decodeWiiGuitar(ext, 6);
+
+        SwitchButtons button_state = m_buttons;
+        button_state.Assign(SwitchButton::L,     (guitar.frets & 0x01) != 0);
+        button_state.Assign(SwitchButton::ZL,    (guitar.frets & 0x02) != 0);
+        button_state.Assign(SwitchButton::R,     (guitar.frets & 0x04) != 0);
+        button_state.Assign(SwitchButton::ZR,    (guitar.frets & 0x08) != 0);
+        button_state.Assign(SwitchButton::B,     (guitar.frets & 0x10) != 0);
+        button_state.Assign(SwitchButton::Up,    guitar.up);
+        button_state.Assign(SwitchButton::Down,  guitar.down);
+        button_state.Assign(SwitchButton::Left,  guitar.left);
+        button_state.Assign(SwitchButton::Right, guitar.right);
+        button_state.SetIf(SwitchButton::Plus,   guitar.plus);
+        button_state.Assign(SwitchButton::X,     guitar.minus);
+        m_buttons = button_state;
+
+        // Whammy on the right stick's X axis: centred at rest, full right when pushed down.
+        m_right_stick.SetValues(
+            static_cast<u16>(SwitchAnalogStick::CenterValue + guitar.whammy * (SwitchAnalogStick::MaximumValue - SwitchAnalogStick::CenterValue)) & SwitchAnalogStick::MaximumValue,
+            SwitchAnalogStick::CenterValue
+        );
+    }
