+        m_buttons.dpad_down = guitar.down;
+        m_buttons.dpad_left = guitar.left;
+        m_buttons.dpad_right = guitar.right;
+        m_buttons.plus |= guitar.plus;
+        m_buttons.X = guitar.minus;
